<!-- Reference only — see note below -->
<ul id="free-bots-list"></ul>

<script>
  // List your XML files here — keep filenames in sync with public/bots/
  const FREE_BOTS = [
    { name: "Martingale", file: "martingale.xml", desc: "Classic doubling strategy" },
    { name: "D'Alembert", file: "dalembert.xml", desc: "Gradual stake increase" }
  ];

  const list = document.getElementById("free-bots-list");
  FREE_BOTS.forEach(bot => {
    const li = document.createElement("li");
    li.innerHTML = `
      <strong>${bot.name}</strong> — ${bot.desc}
      <a href="/bots/${bot.file}" download>Download XML</a>
    `;
    list.appendChild(li);
  });
</script>
